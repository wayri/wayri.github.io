(kicad_wks (version 20231118)
  (setup (left_margin 12) (right_margin 12) (top_margin 12) (bottom_margin 12)
         (linewidth 0.25) (textsize 2.5 2.5) (textlinewidth 0.25))
  (rect (start 0 0 ltcorner) (end 0 0 rbcorner))
  (line (start 0 15 ltcorner) (end 0 15 rtcorner))
  (tbtext "KERO / WEB REVIEW" (pos 4 6 ltcorner) (justify left) (textsize 4 4))
  (tbtext "CUSTOM KICAD WORKSHEET" (pos 4 11 ltcorner) (justify left))
  (rect (start 105 20 rbcorner) (end 0 0 rbcorner))
  (line (start 105 10 rbcorner) (end 0 10 rbcorner))
  (tbtext "${TITLE}" (pos 101 15 rbcorner) (justify left))
  (tbtext "WEBVIEW / DRAWING SAMPLE" (pos 101 5 rbcorner) (justify left))
)
